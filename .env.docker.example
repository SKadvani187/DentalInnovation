# Copy to ".env" (same folder as docker-compose.yml) and fill in real values.
#   cp .env.docker.example .env
# .env holds live secrets — keep it OUT of git.

# ── Public URLs ───────────────────────────────────────────────────────────
# Your real domain (used by the Caddy/HTTPS override).
DOMAIN=yourdomain.com
# Backend base URL the storefront calls. Same domain + /dentinno (single origin).
# HTTP only:  http://yourdomain.com/dentinno
# With Caddy: https://yourdomain.com/dentinno
APP_URL=https://yourdomain.com/dentinno
# API base baked into the React bundle at build time. Must match APP_URL + /api/v1.
# CHANGE THIS -> rebuild the web image (docker compose build web).
VITE_API_URL=https://yourdomain.com/dentinno/api/v1

# ── Database ──────────────────────────────────────────────────────────────
DB_NAME=dentinno_crm
DB_USER=dentinno
DB_PASS=CHANGE_ME_strong_password
DB_ROOT_PASS=CHANGE_ME_strong_root_password

# ── Razorpay (use rzp_live_ keys in production) ─────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── OTP / Email (optional — leave blank to disable) ─────────────────────────
FAST2SMS_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── AI image search (optional) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
